<Window x:Class="ConnectIVRTester.SaveNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Text="File name" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" Padding="4" FontSize="14"/>

        <TextBlock Text="Save location" Margin="0,16,0,4"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="FolderBox" Padding="4" IsReadOnly="True" Background="#F0F0F0"/>
            <Button Grid.Column="1" Content="Browse..." Padding="10,4" Margin="6,0,0,0" Click="Browse_Click"/>
        </Grid>

        <TextBlock x:Name="FullPathPreview" Margin="0,10,0,0" Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Padding="12,4" Click="Cancel_Click"/>
            <Button Content="Save" Padding="12,4" Margin="8,0,0,0" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
