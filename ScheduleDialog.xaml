<Window x:Class="ConnectIVRTester.ScheduleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Schedule"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <StackPanel Margin="16">
        <TextBlock Text="Name" Margin="0,0,0,4"/>
        <TextBox x:Name="NameBox" Padding="4"/>

        <TextBlock Text="Select Batch(es)" Margin="0,12,0,4"/>
        <ScrollViewer Height="110" VerticalScrollBarVisibility="Auto"
                      BorderBrush="#CCC" BorderThickness="1">
            <ItemsControl x:Name="BatchChecklist">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="6,4"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Text="When" Margin="0,12,0,4"/>
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="SingleRadio" Content="Once" GroupName="ScheduleType" IsChecked="True"
                         Checked="ScheduleType_Changed" Margin="0,0,16,0"/>
            <RadioButton x:Name="DailyRadio" Content="Daily" GroupName="ScheduleType"
                         Checked="ScheduleType_Changed" Margin="0,0,16,0"/>
            <RadioButton x:Name="WeeklyRadio" Content="Weekly" GroupName="ScheduleType"
                         Checked="ScheduleType_Changed"/>
        </StackPanel>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <DatePicker x:Name="DatePickerControl" Grid.Column="0" Width="140"/>
            <ComboBox x:Name="DayOfWeekBox" Grid.Column="0" Width="140" Visibility="Collapsed">
                <ComboBoxItem Content="Sunday"/>
                <ComboBoxItem Content="Monday"/>
                <ComboBoxItem Content="Tuesday"/>
                <ComboBoxItem Content="Wednesday"/>
                <ComboBoxItem Content="Thursday"/>
                <ComboBoxItem Content="Friday"/>
                <ComboBoxItem Content="Saturday"/>
            </ComboBox>
            <ComboBox x:Name="TimeOfDayBox" Grid.Column="1" Width="110" Margin="8,0,0,0"/>
        </Grid>

        <CheckBox x:Name="EnabledCheckBox" Content="Enabled" IsChecked="True" Margin="0,12,0,0"/>

        <TextBlock Text="Log Location" Margin="0,12,0,4"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" x:Name="LogLocationBox" Padding="4" IsReadOnly="True" Background="#F0F0F0"/>
            <Button Grid.Column="1" Content="Choose..." Padding="10,4" Margin="6,0,0,0" Click="ChooseLog_Click"/>
        </Grid>
        <TextBlock Text="Required - this schedule's activity is logged here since it runs unattended."
                   TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,4,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Padding="12,4" Click="Cancel_Click"/>
            <Button Content="Save" Padding="12,4" Margin="8,0,0,0" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
